# Restores the newest backup into a scratch database to prove it works (ops/restore-test.sh). Installed by
# scripts/deploy.sh.
[Unit]
Description=jeromebadour.com: weekly restore test of the newest backup
After=docker.service jeromebadour-backup.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/opt/sites/tools/jeromebadour/restore-test.sh
Nice=10
TimeoutStartSec=30min
